# Application Settings
APP_NAME="Portal KLA Konawe"
APP_ENV=production
APP_KEY=base64:hnbgf7r1OFFh46xg6tENInglrSyMdajIOjjfVSqqMho=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_PORT=8080

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

# Database (MySQL in Docker / Podman)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=portal_kla
DB_USERNAME=kla_user
DB_PASSWORD=kla_secret_password_change_me
DB_ROOT_PASSWORD=root_secret_password_change_me
DB_PORT_FORWARD=3306

# Sessions, Cache & Queues (database or redis)
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

# Redis Settings (if using redis)
REDIS_HOST=redis
REDIS_PORT=6379

# Container Automation Flags
AUTO_MIGRATE=true
APP_OPTIMIZE=true
ENABLE_QUEUE_WORKER=false

# Third-party Integrasi Berita & Agenda Konawe
